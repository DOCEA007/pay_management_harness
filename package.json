{
  "name": "ledgermesh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "dotenvx run --quiet --ignore=MISSING_ENV_FILE -- next dev",
    "build": "next build",
    "start": "dotenvx run --quiet --ignore=MISSING_ENV_FILE -- next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@ai-sdk/react": "^4.0.176",
    "@dotenvx/dotenvx": "^2.38.2",
    "ai": "^7.0.172",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
